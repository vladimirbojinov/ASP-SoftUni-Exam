@model ErrorViewModel

@{
    var code = (int)ViewData["StatusCode"]!;
    var alertClass = code >= 500 ? "text-danger" : "text-warning";
}

<h1 class="display-1 fw-bold @alertClass">@code</h1>
<h2 class="mb-3">@ViewData["Title"]</h2>
<p class="lead text-muted mb-4">@ViewData["Message"]</p>
<p class="lead text-muted mb-4">Error ID: @Model.RequestId</p>