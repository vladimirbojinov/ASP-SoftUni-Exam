@model IngredientIndexModel[]

@{
    ViewData["Title"] = "Ingredients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ingredients</h1>
    <a asp-action="Create" class="btn btn-primary">Add ingredient</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No ingredients yet. Add your first one.</div>
}
else
{
    <p class="text-muted">
        Showing @Model.Length ingredient(s)
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col" class="text-center">RecipesCount</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingredient in Model)
                {
                    <tr>
                        <td>@ingredient.Name</td>
                        <td class="text-center">
                            <span class="badge text-bg-secondary">@ingredient.RecipesCount</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@ingredient.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                            @if (ingredient.RecipesCount == 0)
                            {
                                <a asp-action="Delete" asp-route-id="@ingredient.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled>
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}