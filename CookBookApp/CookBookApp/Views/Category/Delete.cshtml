@model CategoryDeleteModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h1 class="h4 mb-0">Delete Category</h1>
                </div>

                <div class="card-body">
                    @if (Model.RecipesCount > 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            This category cannot be deleted because it contains recipes
                        </div>
                    }
                    else
                    {
                        <p class="lead">Are you sure you want to delete this category?</p>
                    }

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Category Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                    </dl>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>

                    <form asp-action="DeleteConfirm" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger" disabled="@(Model.RecipesCount > 0)">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>